{
  "uid": "planta-iot",
  "title": "Planta IoT - Mantenimiento Predictivo",
  "tags": [
    "mcd512",
    "iot",
    "bigdata"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Vibración por máquina (mm/s)",
      "id": 1,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx-planta"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 7
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"planta\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r._field == \"vibracion_mm_s\")\n  |> aggregateWindow(every: 10s, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"maquina\"])\n  |> group(columns: [\"maquina\"])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Temperatura por máquina (°C)",
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx-planta"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"planta\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r._field == \"temperatura_c\")\n  |> aggregateWindow(every: 10s, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"maquina\"])\n  |> group(columns: [\"maquina\"])"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Anomalías detectadas (ventana actual)",
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx-planta"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"planta\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r._field == \"es_anomalia\")\n  |> sum()\n  |> group()\n  |> sum()"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Anomalías por máquina",
      "id": 4,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx-planta"
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"planta\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r._field == \"es_anomalia\")\n  |> group(columns: [\"maquina\"])\n  |> sum()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.maquina}"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Score de anomalía (Isolation Forest)",
      "id": 5,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx-planta"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"planta\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r._field == \"score_anomalia\")\n  |> aggregateWindow(every: 10s, fn: max, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"maquina\"])\n  |> group(columns: [\"maquina\"])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Corriente (A) y RPM",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx-planta"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"planta\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and (r._field == \"corriente_a\" or r._field == \"rpm\"))\n  |> aggregateWindow(every: 15s, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"maquina\", \"_field\"])\n  |> group(columns: [\"maquina\", \"_field\"])"
        }
      ]
    }
  ]
}